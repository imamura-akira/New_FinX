# 后端环境变量模板：只列变量名，不填任何值。
# 复制为 backend/.env 后填写；.env 已在 .gitignore 中，任何情况下不得入库。
# 未填写的开关与限额使用 backend-design.md 第 7 节的默认值（见 internal/config）。

# —— 运行环境 ——
APP_ENV=
HTTP_ADDR=
DATABASE_URL=

# —— PII 字段级加密（AES-256-GCM，32 字节密钥的 base64） ——
PII_ENCRYPTION_KEY=

# —— DriveWealth 凭据（只放这里，不写进代码、文档、日志） ——
DW_BASE_URL=
DW_APP_KEY=
DW_CLIENT_ID=
DW_CLIENT_SECRET=

# —— DW 客户端行为 ——
DW_HTTP_TIMEOUT=
DW_TOKEN_REQUESTS_PER_HOUR=
DW_TOKEN_REFRESH_SKEW=

# —— 待 DW 确认的开关（Q-DW-x） ——
KYC_MODE=
BANK_LINK_METHOD=
USER_SUBMIT_MODE=
SEASONING_DAYS=
SEASONING_START=

# —— 限额与截止时间（示例值，待确认） ——
LIMIT_MIN_DEPOSIT=
LIMIT_MAX_DEPOSIT=
LIMIT_DAILY_DEPOSIT=
LIMIT_MIN_WITHDRAWAL=
LIMIT_MAX_WITHDRAWAL=
LIMIT_MIN_WIRE=
LIMIT_MAX_BANKS=
LIMIT_ACH_CUTOFF_ET=
LIMIT_WIRE_CUTOFF_ET=

# 会话（JWT_SECRET 为 base64，至少 32 字节：openssl rand -base64 48）
JWT_SECRET=
SESSION_TTL=
# 仅开发联调：把邮箱验证码打印到日志（production 禁止）
OTP_DEV_LOG=
# 跨域来源（逗号分隔；iOS 原生 App 不需要，Flutter Web 调试时填 http://localhost:端口）
CORS_ALLOWED_ORIGINS=
# KYC / 账户状态对账周期（默认 1m，范围 5s–1h；演示可设 15s）
KYC_POLL_INTERVAL=
# 沙盒分析：成功响应也记录脱敏后的 DW 响应体（production 禁止）
DW_LOG_BODIES=
# F11 行情：SIM（虚拟行情，默认）| REAL（二期）；MARKET_TICK 默认 2s
MARKET_DATA_MODE=
MARKET_TICK=

# 登录邮箱白名单（逗号分隔，每项以 @ 开头，如 @example.com）。非空时只允许匹配后缀的邮箱请求验证码；空 = 不限制（本机开发留空）
ALLOWED_EMAIL_SUFFIXES=
