# 追加到共用 Caddy 的 Caddyfile（当前 VPS：/opt/elefenjoy-hostinger-demo/Caddyfile.https）。
# 该 Caddy 的 80 端口被其他服务占用，因此关闭 HTTP 验证、用 TLS-ALPN（443）签发证书，写法与同文件其他站点一致。
# 上游为本项目 backend 绑定的 docker0 地址端口（docker-compose.yml 的 BACKEND_BIND）。

finxnew.akira.diy {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            disable_http_challenge
        }
    }
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
    reverse_proxy host.docker.internal:18082 {
        transport http {
            dial_timeout 3s
            response_header_timeout 25s
        }
    }
}
